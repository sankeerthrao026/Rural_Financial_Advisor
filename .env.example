# ============================================================
# RuralCred Advisor — Unified Environment Configuration
# ============================================================

# ------------------------------------------------------------
# 1. AI Stack: Google Gemini (gemini-2.5-flash)
# ------------------------------------------------------------
# Obtain your API key from Google AI Studio: https://aistudio.google.com/app/apikey
# Required for real-time generative strategic advisory & SWOT generation.
# If omitted or offline, the app operates in verified grounded fallback mode using ChromaDB / local datasets.
GEMINI_API_KEY=your-gemini-api-key-here

# ------------------------------------------------------------
# 2. FastAPI Backend & ChromaDB RAG Vector Store
# ------------------------------------------------------------
# URL pointing to the FastAPI Python service (default: http://localhost:8000)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Directory where ChromaDB indexes district benchmarks and government schemes
CHROMA_PERSIST_DIRECTORY=backend/chroma_db

# ------------------------------------------------------------
# 3. Backend Auth (Demo Mode)
# ------------------------------------------------------------
# The backend has NO real token verification yet. Client-supplied x-user-id /
# x-auth-mode headers are trusted ONLY when DEMO_MODE=true (local evaluation).
# Leave unset or false in any shared/real deployment — all protected endpoints
# then reject with 401 instead of trusting client headers.
DEMO_MODE=true

# ------------------------------------------------------------
# 4. Supabase Authentication (Optional)
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ------------------------------------------------------------
# 4. Firebase Firestore (Optional)
# ------------------------------------------------------------
# Offline localStorage cache operates automatically if Firebase is unconfigured.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
